# Supabase Configuration for QuangTri.wiki
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin CMS Authentication (Set strong values in production / Vercel)
ADMIN_EMAIL=admin@quangtri.wiki
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=random-64-char-secret-key

# Production Domain for SEO & OpenGraph
NEXT_PUBLIC_SITE_URL=https://quangtri.wiki
